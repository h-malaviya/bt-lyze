# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# Storage
RECORDING_STORAGE_PROVIDER=supabase
RECORDINGS_BUCKET=recordings
TRANSCRIPTS_BUCKET=transcripts
MAX_RECORDING_SIZE_BYTES=524288000

# Azure Blob Storage (API and worker only; never expose as VITE values)
# Required for service-principal auth. In Azure hosting, managed identity can be
# used instead by leaving the three AZURE identity values empty.
# Grant the identity Storage Blob Data Contributor on the storage account.
# Browser uploads also require Blob service CORS for your exact web origin,
# allowing PUT and the Content-Type and x-ms-blob-type request headers.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=recordings
# Development fallback only. Prefer Entra ID or managed identity in production.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_UPLOAD_SAS_TTL_SECONDS=900
AZURE_READ_SAS_TTL_SECONDS=7200

# Deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_CALLBACK_SECRET=

# Anthropic / Claude Agent SDK
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-4-6
ANALYSIS_CONCURRENCY=3
TRANSCRIBE_CONCURRENCY=16

# Redis
REDIS_URL=redis://redis:6379/0

# Public access
NGROK_AUTHTOKEN=
PUBLIC_BASE_URL=
ALLOWED_ORIGINS=["http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=26214400
LOG_BACKUP_COUNT=5

# Browser-safe Vite values
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
